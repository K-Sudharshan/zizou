# ==============================================================================
# Zizou - Environment Variables Template
# Copy this file to .env.local for local development. Never commit real keys.
# ==============================================================================

# [AI INFERENCE PROVIDER: GROQ OR GEMINI]
# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model ID (default openai/gpt-oss-120b or qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# [ALTERNATIVE: GEMINI]
# Google Gemini API key obtained from Google AI Studio (https://aistudio.google.com/).
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model ID (default gemini-3.7-flash)
GEMINI_MODEL=gemini-3.7-flash

# [REQUIRED FOR EMAIL DELIVERY IN PRODUCTION]
# Resend API key obtained from https://resend.com/api-keys
# Separate from the Gemini API key.
RESEND_API_KEY=re_your_resend_api_key_here

# [REQUIRED FOR EMAIL DELIVERY]
# Verified sender email address and display name in your Resend dashboard.
# Example: Zizou <morning@yourdomain.com> or onboarding@resend.dev (for testing)
EMAIL_FROM=Zizou <onboarding@resend.dev>

# [REQUIRED FOR EMAIL DELIVERY]
# The recipient student's email address.
EMAIL_TO=student@example.com

# [REQUIRED IN DEPLOYMENT]
# Random secret string protecting the /api/cron endpoint from unauthorized callers.
# Generated with: openssl rand -hex 32
CRON_SECRET=your_random_cron_secret_here

# [OPTIONAL] Production Preview Protection
# Protects /api/preview from consuming Gemini quota in production.
PREVIEW_SECRET=your_optional_preview_secret_here

# [OPTIONAL] Reader Personalization Profile
READER_GOALS=First-year computer science student in India focused on AI/ML learning, practical projects, internships, open source, hackathons, and building a strong technology career.

# [OPTIONAL] Time Zone for newspaper date and scheduling calculation (default Asia/Kolkata)
TIME_ZONE=Asia/Kolkata

# [OPTIONAL] News freshness filter in days (default 7, max 14)
NEWS_WINDOW_DAYS=7

# [OPTIONAL] Delivery Kill-Switch
# Defaults to false in local development. Set to true in production once sender is verified.
EMAIL_DELIVERY_ENABLED=false
